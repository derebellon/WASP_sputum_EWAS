# Individual-level data are governed by the WASP consortium and never committed.
data/*
!data/README.md
!data/.gitkeep

# Analysis outputs (aggregate results and figures) ARE published so the repository
# reproduces the paper. Only individual-level data (data/) stays out.
# Exception: the per-sample QC image dump is bulky and not needed (regenerated by step 01).
results/01_quality_control/figure/

# The full per-probe EWAS tables (~850k rows, tens of MB each) are too large for git
# and are regenerated by running the code; publish only the useful summary tables.
results/04_ewas/*.csv
!results/04_ewas/*_FDR.csv
!results/04_ewas/*_HITS.csv
!results/04_ewas/*_Top20.csv
!results/04_ewas/*_Top20_genes.csv
!results/04_ewas/*_SUMMARY.csv
!results/04_ewas/*_UNION_*.csv
!results/04_ewas/*_VOLCANO_CHAMPIONS.csv
!results/04_ewas/EWAS_SUMMARY_*.csv
# Full sensitivity EWAS tables (also ~850k rows) - keep the SIG/summary/overlap only.
results/06_sensitivity_inflammatory/EWAS_SENSITIVITY_*.csv

# Fresh-mode re-run (parallel tree): mirror the results/ exclusions so a
# `git add results_fresh` never commits the ~850k-row per-probe tables.
results_fresh/01_quality_control/figure/
results_fresh/04_ewas/*.csv
!results_fresh/04_ewas/*_FDR.csv
!results_fresh/04_ewas/*_HITS.csv
!results_fresh/04_ewas/*_Top20.csv
!results_fresh/04_ewas/*_Top20_genes.csv
!results_fresh/04_ewas/*_SUMMARY.csv
!results_fresh/04_ewas/*_UNION_*.csv
!results_fresh/04_ewas/*_VOLCANO_CHAMPIONS.csv
!results_fresh/04_ewas/EWAS_SUMMARY_*.csv
results_fresh/06_sensitivity_inflammatory/EWAS_SENSITIVITY_*.csv

# Any other parallel output tree (results_income_*, results_drop_*, ...): same
# rule, keep only the light summary/hit tables, never the per-probe CSVs.
results_*/01_quality_control/figure/
results_*/04_ewas/*.csv
!results_*/04_ewas/*_FDR.csv
!results_*/04_ewas/*_HITS.csv
!results_*/04_ewas/*_Top20.csv
!results_*/04_ewas/*_Top20_genes.csv
!results_*/04_ewas/*_SUMMARY.csv
!results_*/04_ewas/*_UNION_*.csv
!results_*/04_ewas/*_VOLCANO_CHAMPIONS.csv
!results_*/04_ewas/EWAS_SUMMARY_*.csv
results_*/06_sensitivity_inflammatory/EWAS_SENSITIVITY_*.csv

# R / session artefacts
.Rhistory
.RData
.Rproj.user/
*.Rproj
*.log
results/logs/

# OS
.DS_Store

# Old/superseded scripts kept locally only, never published
legacy/

# paper_final: keep the structure and README, not the hand-picked exports
paper_final/main/*
!paper_final/main/.gitkeep
paper_final/supplementary/*
!paper_final/supplementary/.gitkeep

# SLURM logs
logs/

# DataHub delivery package (individual-level methylation + subject IDs) — never published
datahub_package/
